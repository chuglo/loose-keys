<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld items selected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld elemento seleccionado</string>
			<key>other</key>
			<string>%lld elementos seleccionados</string>
		</dict>
	</dict>
	<key>%lld fixed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@fixed@</string>
		<key>fixed</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld corregido</string>
			<key>other</key>
			<string>%lld corregidos</string>
		</dict>
	</dict>
	<key>%lld folders are left out at your request; see Not Checked.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@folders@ a petición tuya; consulta Sin comprobar.</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld carpeta queda excluida</string>
			<key>other</key>
			<string>%lld carpetas quedan excluidas</string>
		</dict>
	</dict>
	<key>%lld folders left out</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@folders@</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld carpeta excluida</string>
			<key>other</key>
			<string>%lld carpetas excluidas</string>
		</dict>
	</dict>
	<key>%lld items</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld elemento</string>
			<key>other</key>
			<string>%lld elementos</string>
		</dict>
	</dict>
	<key>%lld items looked at, %lld found.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@items@, %2$#@found@.</string>
		<key>found</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld hallazgo</string>
			<key>other</key>
			<string>%2$lld hallazgos</string>
		</dict>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld elemento examinado</string>
			<key>other</key>
			<string>%1$lld elementos examinados</string>
		</dict>
	</dict>
	<key>%lld items · Still included in scan results</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld elemento · Sigue incluido en los resultados del análisis</string>
			<key>other</key>
			<string>%lld elementos · Siguen incluidos en los resultados del análisis</string>
		</dict>
	</dict>
	<key>%lld loose keys to review</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@keys@ por revisar</string>
		<key>keys</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld clave suelta</string>
			<key>other</key>
			<string>%lld claves sueltas</string>
		</dict>
	</dict>
	<key>%lld loose keys to review, list full</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@keys@ por revisar, lista llena</string>
		<key>keys</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld clave suelta</string>
			<key>other</key>
			<string>%lld claves sueltas</string>
		</dict>
	</dict>
	<key>%lld places</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@places@</string>
		<key>places</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld lugar</string>
			<key>other</key>
			<string>%lld lugares</string>
		</dict>
	</dict>
	<key>%lld places could not be read. Run a scan to see which.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@places@</string>
		<key>places</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>No se pudo leer %lld lugar. Haz un análisis para ver cuál.</string>
			<key>other</key>
			<string>No se pudieron leer %lld lugares. Haz un análisis para ver cuáles.</string>
		</dict>
	</dict>
	<key>%lld places could not be read. Scan this Mac to see which.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@places@</string>
		<key>places</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>No se pudo leer %lld lugar. Analiza tu Mac para ver cuál.</string>
			<key>other</key>
			<string>No se pudieron leer %lld lugares. Analiza tu Mac para ver cuáles.</string>
		</dict>
	</dict>
	<key>%lld set aside</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@setAside@</string>
		<key>setAside</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld dejado a un lado</string>
			<key>other</key>
			<string>%lld dejados a un lado</string>
		</dict>
	</dict>
	<key>%lld to review</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@open@</string>
		<key>open</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld por revisar</string>
			<key>other</key>
			<string>%lld por revisar</string>
		</dict>
	</dict>
	<key>At least %lld folders left in the current full scan.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Al menos %#@folders@ por leer en el análisis completo actual.</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld carpeta</string>
			<key>other</key>
			<string>%lld carpetas</string>
		</dict>
	</dict>
	<key>Nothing to review, but %lld places could not be read.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>No hay nada que revisar, pero %#@places@</string>
		<key>places</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>no se pudo leer %lld lugar.</string>
			<key>other</key>
			<string>no se pudieron leer %lld lugares.</string>
		</dict>
	</dict>
	<key>The last scan found %lld findings, but they are not in this list. Scan again, or save the report to see them.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>El último análisis encontró %#@findings@</string>
		<key>findings</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld hallazgo, pero no está en esta lista. Vuelve a analizar o guarda el informe para verlo.</string>
			<key>other</key>
			<string>%lld hallazgos, pero no están en esta lista. Vuelve a analizar o guarda el informe para verlos.</string>
		</dict>
	</dict>
	<key>The same credential is in %lld places</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>La misma credencial está en %#@places@</string>
		<key>places</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld lugar</string>
			<key>other</key>
			<string>%lld lugares</string>
		</dict>
	</dict>
	<key>The saved report and the copied summary count %lld findings. The list has %lld items and is full, so findings it has no room for are left out: save the report to see them all. Also, a credential found by more than one rule, or in more than one file, is one item.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>El informe guardado y el resumen copiado registran %1$#@findings@. La lista tiene %2$#@items@ y está llena, así que quedan fuera los hallazgos que no caben en ella: guarda el informe para verlos todos. Además, una credencial encontrada por más de una regla, o en más de un archivo, cuenta como un solo elemento.</string>
		<key>findings</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld hallazgo</string>
			<key>other</key>
			<string>%1$lld hallazgos</string>
		</dict>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld elemento</string>
			<key>other</key>
			<string>%2$lld elementos</string>
		</dict>
	</dict>
	<key>The saved report and the copied summary count %lld findings. The list has %lld items, because a credential found by more than one rule, or in more than one file, is one item.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>El informe guardado y el resumen copiado registran %1$#@findings@. La lista tiene %2$#@items@, porque una credencial encontrada por más de una regla, o en más de un archivo, cuenta como un solo elemento.</string>
		<key>findings</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld hallazgo</string>
			<key>other</key>
			<string>%1$lld hallazgos</string>
		</dict>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld elemento</string>
			<key>other</key>
			<string>%2$lld elementos</string>
		</dict>
	</dict>
	<key>and %lld more. Save the report for the full list.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>y %#@more@ más. Guarda el informe para ver la lista completa.</string>
		<key>more</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
</dict>
</plist>
