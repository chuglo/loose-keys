	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@items@ looked at, %2$#@found@.</string>
		<key>found</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld found</string>
			<key>other</key>
			<string>%2$lld found</string>
		</dict>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld item</string>
			<key>other</key>
			<string>%1$lld items</string>
		</dict>
	</dict>
