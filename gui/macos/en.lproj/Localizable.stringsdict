	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@ · Still included in scan results</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld item</string>
			<key>other</key>
			<string>%lld items</string>
		</dict>
	</dict>
	<key>%lld loose keys to review</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@keys@ to review</string>
		<key>keys</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld loose key</string>
			<key>other</key>
			<string>%lld loose keys</string>
		</dict>
	</dict>
	<key>%lld loose keys to review, list full</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@keys@ to review, list full</string>
		<key>keys</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld loose key</string>
			<key>other</key>
			<string>%lld loose keys</string>
		</dict>
	</dict>
	<key>%lld set aside</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@setAside@</string>
		<key>setAside</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld set aside</string>
			<key>other</key>
			<string>%lld set aside</string>
		</dict>
	</dict>
	<key>%lld to review</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@open@</string>
		<key>open</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld to review</string>
			<key>other</key>
			<string>%lld to review</string>
		</dict>
	</dict>
	<key>At least %lld folders left to check in this full scan.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>At least %#@folders@ left to check in this full scan.</string>
		<key>folders</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld folder</string>
			<key>other</key>
			<string>%lld folders</string>
		</dict>
	</dict>
	<key>The last scan found %lld findings, but they aren't in this list. Scan again, or save the report to see them.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>The last scan found %#@findings@</string>
		<key>findings</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld finding, but it isn't in this list. Scan again, or save the report to see it.</string>
			<key>other</key>
			<string>%lld findings, but they aren't in this list. Scan again, or save the report to see them.</string>
		</dict>
	</dict>
	<key>The last scan found %lld sign-ins, but they aren't in this list. Scan again, or save the report to see them.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>The last scan found %#@signins@</string>
		<key>signins</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld sign-in, but it isn't in this list. Scan again, or save the report to see it.</string>
			<key>other</key>
			<string>%lld sign-ins, but they aren't in this list. Scan again, or save the report to see them.</string>
		</dict>
	</dict>
	<key>The same credential is in %lld places</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>The same credential is in %#@places@</string>
		<key>places</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld place</string>
			<key>other</key>
			<string>%lld places</string>
		</dict>
	</dict>
	<key>The scan found %lld findings, but the list is full at %lld items. Save the report to see them all.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>The scan found %1$#@findings@, but the list is full at %2$#@items@. Save the report to see them all.</string>
		<key>findings</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld finding</string>
			<key>other</key>
			<string>%1$lld findings</string>
		</dict>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld item</string>
			<key>other</key>
			<string>%2$lld items</string>
		</dict>
	</dict>
	<key>and %lld more</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>and %#@more@ more</string>
		<key>more</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
</dict>
</plist>
