/* Latin American Spanish where it differs from es.lproj, mostly the names
   macOS uses. The build adds these over es.lproj/Localizable.strings. */

"Add" = "Agregar";

"OK" = "OK";

"Add Folder or Drive…" = "Agregar carpeta o disco…";

"Approve Loose Keys in System Settings > General > Login Items." = "Aprueba Loose Keys en Configuración del Sistema > General > Elementos de inicio.";

"Open System Settings" = "Abrir Configuración del Sistema";

"They are off. Turn them on in System Settings to hear about new findings while the app is closed." = "Están desactivadas. Actívalas en Configuración del Sistema para enterarte de nuevos hallazgos mientras la app está cerrada.";

"Settings…" = "Configuración…";

"Needs approval in System Settings > General > Login Items" = "Necesita aprobación en Configuración del Sistema > General > Elementos de inicio";

"Off in System Settings" = "Desactivadas en Configuración del Sistema";

"macOS could not restart the background helper. Check System Settings > General > Login Items." = "macOS no pudo reiniciar el proceso auxiliar. Comprueba Configuración del Sistema > General > Elementos de inicio.";

"Automatic scanning does not include added folders and drives. Use Scan Now to check them." = "El análisis automático no incluye las carpetas ni los discos agregados. Usa Analizar ahora para comprobarlos.";

"Open Settings to restart the helper." = "Abre Configuración para reiniciar el proceso auxiliar.";

"Turn on Loose Keys in Login Items to show the icon at login." = "Activa Loose Keys en Elementos de inicio para que el ícono aparezca al iniciar sesión.";

"Shown only while the app is open, because Loose Keys is not in Login Items." = "Solo se muestra mientras la app está abierta, porque Loose Keys no está en Elementos de inicio.";

/* In an alert when the report the person chose to replace could not be moved to the Trash. The first %@ is the new file's name, the second is the reason macOS gave. */
"Loose Keys could not move the old report to the Trash, so it saved the new one next to it as %@. %@" = "Loose Keys no pudo mover el informe anterior al basurero, así que guardó el nuevo a su lado como %@. %@";
