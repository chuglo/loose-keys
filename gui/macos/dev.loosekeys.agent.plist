<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.loosekeys.agent</string>
  <key>BundleProgram</key><string>Contents/MacOS/loose-keys-gui</string>
  <key>ProgramArguments</key>
  <array>
    <string>loose-keys-gui</string>
    <string>--agent</string>
  </array>
  <key>AssociatedBundleIdentifiers</key><string>dev.loosekeys.desktop</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key><false/>
  </dict>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
</dict>
</plist>
